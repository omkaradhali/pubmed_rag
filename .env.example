# Copy this file to .env and fill in your values.
# NEVER commit .env — it is gitignored.

# ─── NCBI ────────────────────────────────────────────────────────────────────
# Free at https://www.ncbi.nlm.nih.gov/account/
# Without key: 3 req/sec. With key: 10 req/sec.
NCBI_API_KEY=your_ncbi_api_key_here

# ─── Vector store ─────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db

# ─── HuggingFace ─────────────────────────────────────────────────────────────
# Optional but recommended. Without it, the model version check is rate-limited
# to 1,000 requests/hour per IP (vs 5,000 with a token).
# Free at https://huggingface.co/settings/tokens
# HF_TOKEN=hf_...

# ─── Embedding provider ───────────────────────────────────────────────────────
# miniml   — all-MiniLM-L6-v2, local, free, 256-token limit (default)
# bge      — BAAI/bge-large-en-v1.5, local, free, 1024-dim, 512-token limit (stronger)
# medcpt   — MedCPT, local, free, biomedical-specific, 512-token limit
# NOTE: changing this requires re-embedding the corpus + rebuilding the vector store.
EMBEDDING_PROVIDER=miniml

# ─── Reranker (cross-encoder second stage) ───────────────────────────────────
# Reranks the dense shortlist by joint (query, chunk) relevance — the main lever
# on retrieval ranking quality. Set RERANK_ENABLED=false for dense-only.
RERANK_ENABLED=true
# ncbi/MedCPT-Cross-Encoder — PubMedBERT cross-encoder, free, local, 512 tokens.
RERANK_MODEL=ncbi/MedCPT-Cross-Encoder
# Child candidates shortlisted by the bi-encoder before reranking.
RERANK_POOL=30

# ─── Hybrid search (BM25 + dense + RRF) ──────────────────────────────────────
# Off by default: on the current evaluation set, dense+rerank alone outperforms
# always-on hybrid. When enabled, BM25 only activates per-query when the query
# contains a recognized biomedical entity (drug name, gene symbol, trial ID) or
# its top score clears BM25_SCORE_THRESHOLD — see docs/decisions/hybrid-bm25-rrf.md.
HYBRID_SEARCH_ENABLED=false
BM25_SCORE_THRESHOLD=90.0
RRF_K=60

# ─── LLM provider ─────────────────────────────────────────────────────────────
# ollama   — local Ollama server, free (default)
# haiku    — claude-haiku-4-5, fast and cheap ($0.003/query)
# sonnet   — claude-sonnet-4-6, best quality ($0.010/query) — production default
# openai   — requires OPENAI_API_KEY
LLM_PROVIDER=ollama

# Model name for the selected provider
# ollama:  llama3.1:8b
# haiku:   claude-haiku-4-5-20251001
# sonnet:  claude-sonnet-4-6
LLM_MODEL=llama3.1:8b

# Ollama base URL (only if not running on localhost)
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Anthropic API key — required for LLM_PROVIDER=haiku or sonnet
# https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API key — required for LLM_PROVIDER=openai
# https://platform.openai.com/account/api-keys
# OPENAI_API_KEY=sk-...

# ─── PHI/PII scrubbing ───────────────────────────────────────────────────────
# De-identifies queries (names, dates of birth, MRNs, phones, SSNs, addresses)
# before they leave the server. Runs ONLY when a cloud egress path is configured
# (LLM_PROVIDER=anthropic/haiku/sonnet/openai). A fully local stack (ollama +
# miniml/bge/medcpt) never scrubs — nothing leaves the box.
#   auto (default) — scrub iff a cloud provider is configured
#   on             — always scrub (defense in depth)
#   off            — never scrub  (NOT for clinical use)
# PHI_SCRUBBING=auto
#
# Requires a spaCy model at deploy time: `python -m spacy download en_core_web_lg`
# PHI_SPACY_MODEL=en_core_web_lg
# PHI_SCORE_THRESHOLD=0.35

# ─── Corpus ──────────────────────────────────────────────────────────────────
# The PubMed search string used at ingestion time. Multi-specialty deployments
# (see docs/decisions/multi-specialty-corpus.md) pick a specialty via the
# --specialty CLI flag on pipeline.py instead of an env var, so each ingestion
# run can target a different corpus — e.g. --specialty oncology or
# --specialty neuroscience. This is the fallback used when no --specialty flag
# is passed.
INGEST_QUERY=oncology[Title/Abstract]

# Maximum abstracts fetched per ingestion run.
INGEST_MAX_RESULTS=500

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins. Defaults to localhost for dev.
# Set to your deployment domain before exposing the API publicly. Never use * in production.
# CORS_ORIGINS=http://localhost:3000,https://myapp.example.com

# ─── API server ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Comma-separated static API keys for X-API-Key header auth.
# Leave empty (default) to disable auth — safe for local dev and trusted networks.
# Set before exposing the API publicly. Rotate by adding a new key, deploying,
# then removing the old one (zero-downtime rotation).
# API_KEYS=sk-your-key-here,sk-another-key-for-rotation
